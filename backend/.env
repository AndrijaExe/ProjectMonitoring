# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-local-app-secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> app/monitoring ###
ADMIN_TOKEN=change-me-admin-token
# Sees everything and may probe, but cannot stop a service, clear history or send mail.
# This is what the phone app carries. Empty means there is no read-only access at all.
ADMIN_READONLY_TOKEN=
DATABASE_URL=postgresql://monitoring:monitoring@127.0.0.1:5433/monitoring
# Comma separated origins allowed to call /api. Empty means localhost only.
CORS_ALLOWED_ORIGINS=
# Render API key, used server-side only to read logs. Empty disables the logs panel.
RENDER_API_KEY=
# Email alerts on health changes. Empty RESEND_API_KEY or ALERT_EMAIL_TO disables them.
# Render injects this into every service; empty means we are not on Render.
RENDER_SERVICE_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=onboarding@resend.dev
# Push alerts to the phone app. Needs nothing here to work: a phone registers itself and
# Expo's push service is open. Set this only if the Expo account turns on enhanced security.
EXPO_ACCESS_TOKEN=
# A sleeping Render free tier instance needs ~30s to wake. The probe retries once,
# so this budget applies twice before a target is reported as timed out.
PROBE_TIMEOUT_SECONDS=20
# How old the newest probe may be before the console says the schedule has stopped. The poll
# runs every half hour, so this leaves room for three missed runs. 0 turns the warning off.
POLL_MAX_AGE_MINUTES=90
# Mail when a game's own counter grows faster than this in an hour: "name=limit" pairs.
# Empty means no rate alarms. Example: ai.fallback=20,chat.blocked=50
ALERT_RATE_PER_HOUR=
# Lets the console stop, start and rebuild the target's service through its host.
# Off by default: the Render key needed for logs can also take services down, and
# reading a dashboard should not be the same decision as acting on it.
CONTROLS_ENABLED=false
LOOP9_DISPLAY_NAME="Loop 9"
LOOP9_HEALTH_URL=https://loop9-backend.onrender.com/healthz
LOOP9_READY_URL=https://loop9-backend.onrender.com/readyz
LOOP9_INGEST_TOKEN=dev-loop9-ingest-token
LOOP9_METRICS_URL=
METRICS_TOKENS=
###< app/monitoring ###
