# Copy to .env.local and replace every change-me value before exposing this
# console beyond localhost.

APP_ENV=dev
APP_SECRET=change-me-local-app-secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

ADMIN_TOKEN=change-me-admin-token
# Matches docker-compose.yml. Managed hosts hand you this value; sslmode is honoured.
DATABASE_URL=postgresql://monitoring:monitoring@127.0.0.1:5433/monitoring
# Comma separated origins allowed to call /api. Empty means localhost only.
# In production set this to the console URL, e.g. https://monitoring-console.onrender.com
CORS_ALLOWED_ORIGINS=
# Render API key, used server-side only to read logs. Empty disables the logs panel.
# The key authorises everything the dashboard can do, so never expose it to a browser.
RENDER_API_KEY=
# Render injects this into every service, so the monitor can read its own logs. Empty off Render.
RENDER_SERVICE_ID=
# Email alerts on health changes, sent over HTTPS because Render blocks SMTP ports on free
# services. Empty RESEND_API_KEY or ALERT_EMAIL_TO disables alerting.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=onboarding@resend.dev
# A sleeping Render free tier instance needs ~30s to wake. The probe retries once,
# so this budget applies twice before a target is reported as timed out.
PROBE_TIMEOUT_SECONDS=20
# How old the newest probe may be before the console says the schedule has stopped. The poll
# runs hourly, so this leaves room for one missed run. 0 turns the warning off.
POLL_MAX_AGE_MINUTES=120
LOOP9_DISPLAY_NAME="Loop 9"
LOOP9_HEALTH_URL=https://loop9-backend.onrender.com/healthz
LOOP9_READY_URL=https://loop9-backend.onrender.com/readyz
LOOP9_INGEST_TOKEN=dev-loop9-ingest-token
# Where Loop 9 publishes its own counters. Empty means the monitor only probes it.
LOOP9_METRICS_URL=https://loop9-backend.onrender.com/metrics
# Secrets for reading those counters, as "gameId=token" pairs separated by commas.
# Must match METRICS_TOKEN on the game's own service.
METRICS_TOKENS=
