# Copy to .env.local and replace every change-me value before exposing this
# console beyond localhost.

APP_ENV=dev
APP_SECRET=change-me-local-app-secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

ADMIN_TOKEN=change-me-admin-token
# Matches docker-compose.yml. Managed hosts hand you this value; sslmode is honoured.
DATABASE_URL=postgresql://monitoring:monitoring@127.0.0.1:5433/monitoring
# A sleeping Render free tier instance needs ~30s to wake. The probe retries once,
# so this budget applies twice before a target is reported as timed out.
PROBE_TIMEOUT_SECONDS=20
LOOP9_DISPLAY_NAME="Loop 9"
LOOP9_HEALTH_URL=https://loop9-backend.onrender.com/healthz
LOOP9_READY_URL=https://loop9-backend.onrender.com/readyz
LOOP9_INGEST_TOKEN=dev-loop9-ingest-token
