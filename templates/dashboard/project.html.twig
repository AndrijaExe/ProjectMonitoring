{% extends 'base.html.twig' %}

{% block title %}{{ detail.card.displayName }} · ProjectMonitoring{% endblock %}

{% block body %}
<section class="hero">
    <div>
        <p class="kicker"><a href="/">Fleet</a> / {{ detail.card.gameId }}</p>
        <h1>{{ detail.card.displayName }}</h1>
        <p class="lede">Last health {{ detail.card.healthStatus|default('unseen') }}{% if detail.card.healthLatencyMs is not null %} in {{ detail.card.healthLatencyMs }}ms{% endif %}. Ready {{ detail.card.readyStatus|default('unseen') }}{% if detail.card.readyLatencyMs is not null %} in {{ detail.card.readyLatencyMs }}ms{% endif %}.</p>
    </div>
    <form method="post" action="/projects/{{ detail.card.gameId }}/refresh">
        <button type="submit">Poll now</button>
    </form>
</section>

<section class="split">
    <article>
        <h2>Health history</h2>
        {% if detail.healthHistory is empty %}
            <p class="empty">No probes stored yet. Poll once to fill this lane.</p>
        {% else %}
            <table>
                <thead>
                    <tr><th>When</th><th>Probe</th><th>Status</th><th>HTTP</th><th>ms</th></tr>
                </thead>
                <tbody>
                    {% for row in detail.healthHistory %}
                        <tr>
                            <td class="mono">{{ row.checked_at }}</td>
                            <td>{{ row.endpoint }}</td>
                            <td class="status status-{{ row.status }}">{{ row.status }}</td>
                            <td class="mono">{{ row.http_code }}</td>
                            <td class="mono">{{ row.latency_ms }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </article>
    <article>
        <h2>Recent ingest</h2>
        {% if detail.card.recentMetricTotals is not empty %}
            <ul class="totals">
                {% for name, total in detail.card.recentMetricTotals %}
                    <li><span>{{ name }}</span><span class="mono">{{ total }}</span></li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if detail.recentMetrics is empty %}
            <p class="empty">No metrics yet. POST /api/v1/projects/{{ detail.card.gameId }}/metrics with X-Ingest-Token.</p>
        {% else %}
            <table>
                <thead>
                    <tr><th>When</th><th>Name</th><th>Value</th></tr>
                </thead>
                <tbody>
                    {% for metric in detail.recentMetrics %}
                        <tr>
                            <td class="mono">{{ metric.recorded_at }}</td>
                            <td>{{ metric.name }}</td>
                            <td class="mono">{{ metric.value }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </article>
</section>
{% endblock %}
