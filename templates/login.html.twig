{% extends 'base.html.twig' %}

{% block title %}Sign in · ProjectMonitoring{% endblock %}

{% block body %}
<section class="login">
    <p class="kicker">Operator access</p>
    <h1>Enter the admin token</h1>
    <p class="lede">This console only shows health and ingest metrics. Management controls come later.</p>
    {% if not configured %}
        <p class="alert">ADMIN_TOKEN is not configured (needs at least 16 characters).</p>
    {% endif %}
    {% if error %}
        <p class="alert">{{ error }}</p>
    {% endif %}
    <form method="post">
        <label for="admin_token">Admin token</label>
        <input id="admin_token" name="admin_token" type="password" autocomplete="current-password" required>
        <button type="submit">Open console</button>
    </form>
</section>
{% endblock %}
