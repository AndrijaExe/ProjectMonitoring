# Copy to .env.local to save typing the host on the sign-in screen.
#
# Optional. Without it the app asks for the API host once and keeps it, which is the safer
# default: Render appends a suffix when a service name is taken, so a build cannot be sure of
# the hostname and one baked in wrong would need rebuilding to fix.
EXPO_PUBLIC_API_BASE_URL=https://monitoring-api.onrender.com
